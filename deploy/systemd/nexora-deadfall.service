[Unit]
Description=NEXORA DEADFALL Dedicated Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deadfall
Group=deadfall
WorkingDirectory=/opt/nexora-deadfall
EnvironmentFile=/etc/nexora-deadfall/nexora-deadfall.env
ExecStart=/opt/nexora-deadfall/scripts/server/run_server.sh
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nexora-deadfall /var/lib/nexora-deadfall /var/log/nexora-deadfall
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
