[Unit]
Description=NEXORA DEADFALL Dedicated Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deadfall
Group=deadfall
WorkingDirectory=/opt/nexora-deadfall
Environment=DEADFALL_PORT=24560
ExecStart=/opt/nexora-deadfall/scripts/server/run_server.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/nexora-deadfall

[Install]
WantedBy=multi-user.target
