#!/usr/bin/env bash
set -euo pipefail
ENV=/etc/nexora-deadfall/nexora-deadfall.env
[[ -f "$ENV" ]] && set -a && source "$ENV" && set +a
ROOT="${DEADFALL_ROOT:-/opt/nexora-deadfall}"
case "${1:-status}" in
  update) exec sudo "$ROOT/deploy/vps/update.sh" "${@:2}";;
  build-app) exec sudo "$ROOT/scripts/build/build_android_vps.sh";;
  build-web) exec sudo "$ROOT/scripts/build/build_download_site.sh";;
  build-all)
    sudo "$ROOT/scripts/build/build_android_vps.sh"
    sudo "$ROOT/scripts/build/build_download_site.sh"
    sudo systemctl restart nexora-deadfall nexora-deadfall-download
    ;;
  status)
    systemctl --no-pager --full status nexora-deadfall nexora-deadfall-download nginx || true
    echo
    [[ -f /var/lib/nexora-deadfall/install-state.json ]] && cat /var/lib/nexora-deadfall/install-state.json
    echo
    [[ -f /var/www/nexora-deadfall/release.json ]] && cat /var/www/nexora-deadfall/release.json
    ;;
  logs) journalctl -u nexora-deadfall -u nexora-deadfall-download -n "${2:-150}" --no-pager;;
  https)
    [[ -n "${DEADFALL_DOMAIN:-}" && -n "${DEADFALL_EMAIL:-}" ]] || { echo "Configura DEADFALL_DOMAIN y DEADFALL_EMAIL en $ENV" >&2; exit 1; }
    [[ -f "$ROOT/deploy/vps/lib/common.sh" ]] || { echo "Instalación administrada incompleta: falta $ROOT/deploy/vps/lib/common.sh" >&2; exit 1; }
    sudo bash -c 'set -euo pipefail; source "$1/deploy/vps/lib/common.sh"; configure_nginx_site "$1/deploy/nginx/nexora-deadfall.conf.template" "$2"' bash "$ROOT" "$DEADFALL_DOMAIN"
    sudo systemctl reload nginx
    sudo certbot --nginx --agree-tos --redirect -m "$DEADFALL_EMAIL" -d "$DEADFALL_DOMAIN"
    sudo bash -c 'set -euo pipefail; source "$1/deploy/vps/lib/common.sh"; configure_nginx_site "$1/deploy/nginx/nexora-deadfall.conf.template" "$2"' bash "$ROOT" "$DEADFALL_DOMAIN"
    sudo systemctl reload nginx
    curl -kfsS --max-time 8 --resolve "$DEADFALL_DOMAIN:443:127.0.0.1" "https://$DEADFALL_DOMAIN/" >/dev/null
    echo "HTTPS DEADFALL activo: https://$DEADFALL_DOMAIN/"
    ;;
  auth)
    exec sudo -Hu deadfall bash -c 'cd "$HOME" && exec gh auth login --hostname github.com --git-protocol https'
    ;;
  *) echo "Uso: nexora-deadfall {status|update|build-app|build-web|build-all|logs|https|auth}"; exit 2;;
esac
